import argparse
import json
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

SRC_ROOT = Path(__file__).resolve().parents[1]
if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))

from processing.foody_transform import transform_foody_object
from storage.data_versioning import MANIFEST_SCHEMA_VERSION, TRANSFORM_VERSION, parse_raw_key, transform_fingerprint
from storage.minio_client import MINIO_BUCKET, create_minio_client, list_object_names, require_bucket
from storage.postgres_client import get_thread_postgres_connection
from storage.postgres_repository import load_versioned_object
from storage.raw_snapshots import freeze_object
from utils.source_codes import validate_source_code

DEFAULT_WORKERS = 8
TRANSFORMERS = {"foody": transform_foody_object}


def find_restaurant_objects(source_code, city=None, limit=None):
    prefix = f"{source_code}/raw/" + (f"{city}/" if city else "")
    objects = []
    for key in list_object_names(prefix=prefix, client=create_minio_client()):
        if key.endswith("/restaurant.json"):
            parse_raw_key(key, source_code)
            objects.append(key)
            if limit and len(objects) >= limit:
                break
    return objects


def read_manifest(path, source):
    manifest = json.loads(Path(path).read_text(encoding="utf-8"))
    if (manifest.get("schema_version") != MANIFEST_SCHEMA_VERSION or
            manifest.get("status") != "complete" or manifest.get("source") != source or
            manifest.get("bucket") != MINIO_BUCKET or manifest.get("failures")):
        raise ValueError("Manifest must be complete and match source/bucket/schema")
    entries = manifest.get("entries", [])
    if not entries or len(entries) != manifest.get("selected_files"):
        raise ValueError("Manifest entry count mismatch")
    seen = set()
    for entry in entries:
        city, restaurant_id, digest = parse_raw_key(entry["object_name"], source)
        if not digest or digest != entry["sha256"]:
            raise ValueError("Manifest must select immutable keys with matching SHA-256")
        identity = restaurant_id  # DB identity is source + restaurant, across all cities.
        if identity in seen:
            raise ValueError("Manifest contains multiple snapshots for one restaurant")
        seen.add(identity)
    return entries


def process_one_object(source_code, object_name, dry_run, expected_sha256=None):
    raw, provenance = freeze_object(source_code, object_name, expected_sha256, persist=not dry_run)
    transformed = TRANSFORMERS[source_code](raw, provenance["object_name"])
    count = len(transformed.get("reviews", []))
    if dry_run:
        return {"object_name": provenance["object_name"], "reviews_found": count, "dry_run": True}
    provenance.update(transform_version=TRANSFORM_VERSION, code_sha256=transform_fingerprint())
    conn = get_thread_postgres_connection()
    try:
        stats = load_versioned_object(conn, transformed, provenance)
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    return {"object_name": provenance["object_name"], "reviews_found": count, **stats, "dry_run": False}


def parse_args():
    parser = argparse.ArgumentParser(description="Load exact raw snapshots into PostgreSQL with a version ledger")
    parser.add_argument("--source", default="foody")
    parser.add_argument("--workers", type=int, default=DEFAULT_WORKERS)
    parser.add_argument("--city")
    parser.add_argument("--limit", type=int)
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument("--object-key")
    selection.add_argument("--manifest", type=Path)
    parser.add_argument("--dry-run", action="store_true", help="Read/transform only; no MinIO or PostgreSQL writes")
    return parser.parse_args()


def main():
    args = parse_args()
    source = validate_source_code(args.source)
    if source not in TRANSFORMERS:
        raise NotImplementedError(f"No transformer for {source}")
    if args.workers < 1 or (args.limit is not None and args.limit < 1):
        raise ValueError("workers/limit must be positive")
    require_bucket()
    if args.manifest:
        entries = read_manifest(args.manifest, source)
        if args.city:
            entries = [entry for entry in entries if parse_raw_key(entry["object_name"], source)[0] == args.city]
        if args.limit:
            entries = entries[:args.limit]
    else:
        keys = [args.object_key] if args.object_key else find_restaurant_objects(source, args.city, args.limit)
        entries = [{"object_name": key, "sha256": None} for key in keys]
    if not entries:
        raise RuntimeError("No matching raw snapshots")
    totals = {"reviews_found": 0, "inserted_reviews": 0, "updated_reviews": 0,
              "existing_reviews": 0, "superseded_reviews": 0}
    failed = 0
    with ThreadPoolExecutor(max_workers=args.workers) as executor:
        futures = {executor.submit(process_one_object, source, entry["object_name"], args.dry_run, entry["sha256"]): entry
                   for entry in entries}
        for future in as_completed(futures):
            try:
                stats = future.result()
                for key in totals:
                    totals[key] += stats.get(key, 0)
                print(f"{'TRANSFORMED' if args.dry_run else 'LOADED'} {stats['object_name']}", flush=True)
            except Exception as exc:
                failed += 1
                print(f"FAILED {futures[future]['object_name']}: {type(exc).__name__}: {exc}", flush=True)
    print(json.dumps({"objects_selected": len(entries), "failed_objects": failed, **totals}))
    if failed:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
